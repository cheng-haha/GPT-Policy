+extract_eval_success() {
+  local result_path="$1"
+  python3 - "${result_path}" <<'PY'
+import json
+from pathlib import Path
+import sys
+
+payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
+details = payload.get("details") or {}
+success = bool(details) and all(bool(item.get("success")) for item in details.values() if isinstance(item, dict))
+success = success and float(payload.get("success_rate", 0.0)) >= 1.0
+print("1" if success else "0")
+PY
+}
