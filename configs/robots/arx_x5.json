{
  "agent": "codex",
  "runtime": {
    "robot_model": "X5",
    "interface": "can1",
    "right_interface": "can3",
    "gripper_open_readout": -3.4,
    "camera_width": 640,
    "camera_height": 480,
    "convert_camera_images_to_jpeg": true,
