    "trajectory_hz": 100.0,
    "task_name": "task",
    "record_dir": null,
    "input_json": null
  },
  "tool_catalog": "configs/tools.json",
  "robot": {
    "gravity_compensation": true,
    "gripper_width_m": 0.088,
