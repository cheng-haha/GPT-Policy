    "settle_timeout_s": 3.0,
    "ik_refine_iterations": 12,
    "ik_translation_tolerance_m": 0.0001,
    "ik_rotation_tolerance_rad": 0.0005,
    "ik_execution_translation_tolerance_m": 0.002,
    "ik_execution_rotation_tolerance_rad": 0.0174532925,
    "joint_velocity_rad_s": 0.6
