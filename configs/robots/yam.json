{
  "agent": "codex",
  "agent_config_dir": "..",
  "backend": "yam",
  "camera_backend": "realsense",
  "tool_catalog": "configs/tools.json",
  "runtime": {
    "robot_model": "YAM",
    "interface": "can0",
    "right_interface": "can1",
    "gripper_open_readout": -3.4,
    "camera_width": 640,
    "camera_height": 480,
    "convert_camera_images_to_jpeg": true,
    "camera_jpeg_quality": 85,
